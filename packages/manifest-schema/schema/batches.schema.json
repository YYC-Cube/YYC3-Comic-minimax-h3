{
  "$ref": "#/definitions/batches",
  "definitions": {
    "batches": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "enum": [1, 2],
          "description": "v1=执行统计型；v2=+调度配置字段（seed_list/aspect_profiles/active_profiles/quality_gate/schedule，Phase A3 · YYC3-68 §7.3）"
        },
        "generated_at": {
          "type": "string"
        },
        "score_scale": {
          "type": "string"
        },
        "batches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "time": {
                "type": "string"
              },
              "ended": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": "string"
              },
              "pipeline": {
                "type": "string"
              },
              "refImages": {
                "type": "integer"
              },
              "seeds": {
                "type": "integer"
              },
              "success": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              },
              "skipped": {
                "type": "integer"
              },
              "avgScore": {
                "type": "number"
              },
              "maxScore": {
                "type": "number"
              },
              "status": {
                "type": "string"
              },
              "videos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "ref": {
                      "type": "string"
                    },
                    "seed": {
                      "type": "integer"
                    },
                    "score": {
                      "type": "number"
                    },
                    "source": {
                      "type": "string"
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "video_path": {
                      "type": "string"
                    },
                    "gen_seconds": {
                      "type": "number"
                    },
                    "peak_rss_gb": {
                      "type": "number"
                    },
                    "av_offset": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "ref",
                    "seed",
                    "score",
                    "source",
                    "tags"
                  ],
                  "additionalProperties": false
                }
              },
              "defects": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": {}
              },
              "durationMin": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "seed_list": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "description": "v2 调度配置：候选种子清单（元启·天枢 SEED 演进输入）"
              },
              "aspect_profiles": {
                "type": "object",
                "properties": {
                  "16:9": {
                    "type": "object"
                  },
                  "9:16": {
                    "type": "object"
                  },
                  "1:1": {
                    "type": "object"
                  }
                },
                "additionalProperties": {
                  "type": "object"
                },
                "description": "v2 调度配置：画幅档参数（compose/dynamic/concat ASPECT 三档）"
              },
              "active_profiles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "16:9",
                    "9:16",
                    "1:1"
                  ]
                },
                "description": "v2 调度配置：本批次启用的画幅档"
              },
              "quality_gate": {
                "type": "object",
                "properties": {
                  "red_line": {
                    "type": "number"
                  },
                  "review_cmd": {
                    "type": "string"
                  },
                  "recheck_max": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false,
                "description": "v2 调度配置：质检门禁（红线 80/复检 ≤2 轮）"
              },
              "schedule": {
                "type": "object",
                "properties": {
                  "window": {
                    "type": "string"
                  },
                  "slots": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false,
                "description": "v2 调度配置：发布排期（知遇·伯乐建议落点，联动 ops 台账）"
              },
              "audio_high_quality": {
                "type": "boolean",
                "description": "v2.1（YYC3-72 M1决议 A2）：true=启用 ≥192k 高音质分支；缺省 false=语音向基线 ≥128k（校验阈值带 AAC VBR 容差：120k/184k）"
              }
            },
            "required": [
              "id",
              "time",
              "model",
              "pipeline",
              "refImages",
              "seeds",
              "success",
              "failed",
              "skipped",
              "avgScore",
              "maxScore",
              "status",
              "videos",
              "defects",
              "params"
            ],
            "additionalProperties": false
          }
        },
        "top10": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rank": {
                "type": "integer"
              },
              "batch": {
                "type": "string"
              },
              "img": {
                "type": "string"
              },
              "seed": {
                "type": "integer"
              },
              "score": {
                "type": "number"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "rank",
              "batch",
              "img",
              "seed",
              "score",
              "tags"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "generated_at",
        "score_scale",
        "batches",
        "top10"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
