# YYC³ MiniMax-H3 环境变量模板（密钥零入库：真实 .env 不入仓）
# 消费方：drama_stage_adapter.H3VisionClient（经 0379-World/编排引擎调用）
# 与 server/api.py 本地起服

# ── H3 agent 网关（跨仓调用方需配置）──
# H3 agent 网关地址（留空则调用方回落 stub，永不断流）
H3_AGENT_GATEWAY=
# X-Claim-Token 共享密钥（发放自 H3 仓库 .secrets/agent_claim.env，勿入库）
AGENT_CLAIM_SECRET=
H3_CLAIM_TTL=300
H3_GATEWAY_TIMEOUT=30

# ── H3 服务端（server/api.py）──
# 端口归属 AI 服务红线段（40000-44999），M3 部署时确定
H3_API_PORT=40202
# 生成模式标签：preview（Mac 剪枝/MPS）| quality（DGX NF4/CUDA）
H3_RUN_MODE=preview
